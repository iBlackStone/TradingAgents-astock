# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# Optional Web UI defaults. If LLM_PROVIDER is empty and exactly one API key
# above is configured, the UI selects that provider automatically.
# Example for DeepSeek: deepseek / deepseek-v4-flash / deepseek-v4-pro
LLM_PROVIDER=
QUICK_THINK_LLM=
DEEP_THINK_LLM=

# 第三方中转 / 代理网关地址（可选）。设置后所有模型请求走此地址，
# 方便国内通过中转访问 Claude / OpenAI 等。Web UI 侧边栏也可直接填写。
# 例: BACKEND_URL=https://your-proxy.com/v1
BACKEND_URL=
